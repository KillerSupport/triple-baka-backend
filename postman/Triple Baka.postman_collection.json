{
  "info": {
    "name": "Triple Baka Anime Merchandise API",
    "description": "Runs the full catalog, cart and order workflow. Set adminEmail and adminPassword locally. Use a demo database for the full runner, which creates a unique customer, catalog and orders. Read README.md for admin setup and the shorter presentation sequence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "secret"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": "",
      "type": "secret"
    },
    {
      "key": "wrongPassword",
      "value": "",
      "type": "secret"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "cartItemId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "pendingOrderId",
      "value": ""
    },
    {
      "key": "disposableProductId",
      "value": ""
    },
    {
      "key": "disposableCategoryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API root",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}').slice(0, 12));",
              "pm.collectionVariables.set('demoPassword', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('wrongPassword', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response contract', () => {",
              "  pm.expect(pm.response.text()).to.eql('Hello World!');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"FullName\": \"Postman Customer\",\n  \"Email\": \"customer-{{runId}}@example.test\",\n  \"Password\": \"{{demoPassword}}\",\n  \"Role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Response contract', () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.user.Role).to.eql('customer');",
              "  pm.expect(data.user).to.not.have.property('Password');",
              "});"
            ]
          }
        }
      ]
    },
